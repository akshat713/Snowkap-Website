# Backend configuration — copy to .env for local work, or set these as
# environment variables on your host. .env is gitignored and must stay that way.
#
# python-dotenv does not override variables already present in the environment,
# so a hosting platform's injected values win and no file is needed in production.
#
# Every value below is a placeholder. Do not commit real ones.

# --- Database ---------------------------------------------------------------
# MongoDB connection string, e.g. from Atlas. Contains a password: secret.
MONGO_URL=mongodb://localhost:27017
DB_NAME=snowkap

# --- HTTP -------------------------------------------------------------------
# Comma-separated origins allowed to call this API. Must include the site's
# own origin, e.g. https://akshat713.github.io
CORS_ORIGINS=http://localhost:3000

# --- Auth -------------------------------------------------------------------
# Signs admin session tokens. Any long random string; rotating it invalidates
# every existing session. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# Seeded on first boot to create the admin login.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# --- Managed services -------------------------------------------------------
# Emergent transactional email key. Omit and email sending is skipped with a
# warning rather than failing.
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Snowkap
# Where new lead notifications are sent. Defaults to ADMIN_EMAIL if unset.
LEAD_NOTIFY_EMAIL=

# --- Ask Snowkap AI ---------------------------------------------------------
# Anthropic API key. This is what the assistant runs on. Billed per call, so
# treat it like a payment credential: server-side only, never in any REACT_APP_*
# variable and never anywhere it can reach the browser. A key in the frontend
# bundle is a key anyone can read and spend.
ANTHROPIC_API_KEY=

# Which model answers. Haiku 4.5 is the cheap tier ($1/$5 per million tokens)
# and is the right shape for this job: short answers, latency-sensitive, grounded
# in a system prompt rather than in reasoning. Raise it only if answer quality
# demands it — the cost difference is 5× at minimum.
CHAT_MODEL=claude-haiku-4-5

# Legacy Emergent LLM key. Only consulted when ANTHROPIC_API_KEY is absent, so an
# existing deployment keeps answering until the Anthropic key is set. With
# neither key present /chat/stream returns 503 and the site answers from the
# knowledge base compiled into the frontend bundle.
EMERGENT_LLM_KEY=
