# Only REACT_APP_* values belong here, and every one of them is compiled into the
# bundle and readable in the browser. Never put a secret in this file — it is
# committed, and even if it were not, the build would publish it.

# The FastAPI backend: leads, newsletter, proposals, dossier counts, the resource
# library, the admin dashboard. Every form on the site posts here fire-and-forget,
# so an unreachable value degrades quietly rather than breaking a page.
REACT_APP_BACKEND_URL=https://smooth-product.preview.emergentagent.com

# Ask Snowkap AI, served separately because it is the one endpoint small enough for
# an edge worker — see edge/README.md. Set this to the deployed worker and leave
# REACT_APP_BACKEND_URL alone; pointing that at the worker instead would 404 every
# form on the site. Unset, the assistant falls back to REACT_APP_BACKEND_URL, and
# if that is unreachable too it answers from the knowledge base compiled into the
# bundle.
REACT_APP_CHAT_URL=

# Optional IP geolocation for the language offer. Off unless set: the time zone and
# the browser's own language list already decide correctly for almost everyone, and
# an unconditional lookup would send every visitor's address to a third party.
# Any endpoint returning JSON with a two-letter country under `country`,
# `country_code` or `countryCode` works.
REACT_APP_GEO_ENDPOINT=

WDS_SOCKET_PORT=443
ENABLE_HEALTH_CHECK=false
